---
// Everything around the session, as one grid of cards: a title, a sentence or two, and the thing
// itself (a working fragment, the app's real keys, or the app itself). What came in 0.2.4 (the
// Wall, who sent whom, launch.json servers, DeepSeek Harness plugins) is drawn from the app's own
// parts at their size, in the bento's dark app tones, rather than as pictures.
import { data, news } from '../data/site';
const shots = [
  { id: 'desk', title: 'The Desk', text: 'Sessions sort themselves by what they need from you. Press what waits, and one press decides.', src: '/media/mac-desk.webp', alt: 'Home with the Desk open: the tide fix back with you with one file to review, and the tide screen design done.', pos: 'left' },
  { id: 'design', title: 'Designs', text: 'Any agent draws the screen beside the session. Point at a part to change it, then Build it.', src: '/media/mac-design.webp', alt: 'A session that asked for a home screen for the tide tables, with the Design surface beside it showing the phone screen.', pos: 'right' },
  { id: 'addons', title: 'Add-ons, made in Workshop', text: "Ask for what Liner Code doesn't have, and an agent makes it. Nothing goes in until you say yes.", src: '/media/mac-addons-page.webp', alt: 'The Add-ons page with nothing added yet, and Make one with an agent.', pos: 'left', link: { href: '/workshop/', label: 'About Workshop' } },
];

// The app's icons (ui/src/app/icons.tsx): one family on a 16px grid, 1.5 strokes, round ends.
const icon = (d: string, s = 14) => `<svg viewBox="0 0 16 16" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const ic = {
  wall: icon('<rect x="2.25" y="2.25" width="4.5" height="4.5" rx="1.25"/><rect x="9.25" y="2.25" width="4.5" height="4.5" rx="1.25"/><rect x="2.25" y="9.25" width="4.5" height="4.5" rx="1.25"/><rect x="9.25" y="9.25" width="4.5" height="4.5" rx="1.25"/>'),
  hand: icon('<path d="M5.5 8.5V4.25a.95.95 0 0 1 1.9 0V7.5M7.4 7V3.4a.95.95 0 0 1 1.9 0V7M9.3 7V4.1a.95.95 0 0 1 1.9 0v4.6c0 2.7-1.6 4.55-3.9 4.55-1.5 0-2.4-.8-3.2-2L2.9 8.9a.95.95 0 0 1 1.5-1.1l1.1 1.2"/>'),
  check: icon('<path d="M3.5 8.4 6.5 11.25 12.5 4.75"/>', 13),
  file: icon('<path d="M9.25 2.75h-4.5a1 1 0 0 0-1 1v8.5a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-6.5Z"/><path d="M9.25 2.75v2.25a.75.75 0 0 0 .75.75h2.25"/>', 13),
  verified: icon('<circle cx="8" cy="8" r="5.75"/><path d="m5.5 8.25 1.75 1.75 3.25-3.5"/>', 13),
  settle: icon('<circle cx="8" cy="8" r="5.5"/><path d="m5.75 8.1 1.6 1.6 2.9-3.2"/>'),
  send: icon('<path d="M8 12.75V3.5M4.25 7.25 8 3.5l3.75 3.75"/>'),
  fanout: icon('<path d="M4.25 2.75v7.5a1.75 1.75 0 0 0 1.75 1.75h2.5M4.25 6.25h4.25"/><circle cx="10.25" cy="6.25" r="1.75"/><circle cx="10.25" cy="12" r="1.75"/>'),
  explore: icon('<circle cx="7.25" cy="7.25" r="4.5"/><path d="m10.6 10.6 2.65 2.65"/>', 11),
  test: icon('<path d="M6.25 2.25h3.5M6.75 2.25v4L3.4 12.1a1 1 0 0 0 .87 1.4h7.46a1 1 0 0 0 .87-1.4L9.25 6.25v-4M4.9 9.5h6.2"/>', 11),
  sub: icon('<path d="M8 2.25Q9.3 6.7 13.75 8 9.3 9.3 8 13.75 6.7 9.3 2.25 8 6.7 6.7 8 2.25Z"/>', 11),
  chevD: icon('<path d="M4.25 6.25 8 10l3.75-3.75"/>', 11),
  info: icon('<circle cx="8" cy="8" r="5.75"/><path d="M8 7.4v3.6M8 5.15v.1"/>'),
  server: icon('<rect x="2.75" y="2.75" width="10.5" height="10.5" rx="2.25"/><path d="M2.75 8h10.5M5.25 5.4h2M5.25 10.6h2"/>', 15),
  refresh: icon('<path d="M13.25 8a5.25 5.25 0 1 1-1.54-3.71"/><path d="M12.25 1.9v2.75H9.5"/>', 13),
  play: icon('<path d="M5.25 4.3v7.4a.9.9 0 0 0 1.36.77l6.1-3.7a.9.9 0 0 0 0-1.54l-6.1-3.7a.9.9 0 0 0-1.36.77Z"/>'),
  globe: icon('<circle cx="7.75" cy="7.75" r="5.5"/><path d="M2.25 7.75h11M7.75 2.25c1.45 1.55 2.2 3.4 2.2 5.5s-.75 3.95-2.2 5.5c-1.45-1.55-2.2-3.4-2.2-5.5s.75-3.95 2.2-5.5Z"/>'),
  chip: icon('<rect x="4" y="4" width="8" height="8" rx="1.5"/><path d="M6.5 1.75V4M9.5 1.75V4M6.5 12v2.25M9.5 12v2.25M1.75 6.5H4M1.75 9.5H4M12 6.5h2.25M12 9.5h2.25"/>', 16),
  link: icon('<path d="M6.75 9.25a2.5 2.5 0 0 0 3.54 0l2-2a2.5 2.5 0 0 0-3.54-3.54l-.5.5M9.25 6.75a2.5 2.5 0 0 0-3.54 0l-2 2a2.5 2.5 0 0 0 3.54 3.54l.5-.5"/>'),
};
const stop = (s = 10) => `<svg viewBox="0 0 16 16" width="${s}" height="${s}" aria-hidden="true"><rect x="3" y="3" width="10" height="10" rx="2.2" fill="currentColor"/></svg>`;
// A model at work: the app's Rays.
const rays = (s = 11) => `<svg viewBox="0 0 10 10" width="${s}" height="${s}" aria-hidden="true"><circle cx="5" cy="5" r="2" fill="currentColor"/><path d="M5 .5v1.4M5 8.1v1.4M.5 5h1.4M8.1 5h1.4M1.8 1.8l1 1M7.2 7.2l1 1M8.2 1.8l-1 1M2.8 7.2l-1 1" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>`;
// The words a card's text writes as code.
const coded = (s: string) => s.split(/(\.claude\/launch\.json|server_start)/);
const w = news.wall, c = news.crew, sv = news.servers, pl = news.plugins, pr = news.pair;
const tone = { needs: 'warn', working: undefined, done: 'ok' } as Record<string, string | undefined>;
---
<section class="bento" id="features" data-tone="paper" aria-labelledby="bento-title">
  <h2 class="bento__title" id="bento-title" data-split="words">Everything around the session</h2>
  <div class="bento__grid">

    <article class="card card--span card--wall" id="wall" data-reveal="up">
      <div class="card__head">
        <div class="card__lead">
          <p class="card__new">{news.since}</p>
          <h3 class="card__title">{w.title}<span class="card__keys" aria-label="Command Shift O"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>O</kbd></span></h3>
          <p class="card__text">{w.text}</p>
        </div>
        <p class="card__aside">{w.aside}</p>
      </div>
      <div class="card__show card__frag">
        <div class="frag wall" data-ui role="img" aria-label={w.alt}>
          <div class="wall__bar" aria-hidden="true">
            <span class="wall__name"><Fragment set:html={ic.wall} />The Wall</span>
            <span class="ui-note wall__count">3 sessions · 1 working</span>
            <span class="wall__seg"><span class="is-on">All <i>3</i></span><span>Needs you <i>1</i></span><span>Working <i>1</i></span><span>Done <i>1</i></span></span>
            <span class="wall__hint"><kbd>1</kbd> to <kbd>9</kbd> opens one</span>
          </div>
          <div class="wall__grid" aria-hidden="true">
            {w.tiles.map((t: any, i) => (
              <div class="wt" data-kind={t.kind} data-picked={i === 0 ? '' : undefined}>
                <div class="wt__head">
                  <span class="wt__n">{i + 1}</span>
                  <span class="wt__title">{t.title}</span>
                  <span class="wt__state" data-tone={tone[t.kind]}>
                    {t.kind === 'needs' && <span class="wt__dot" />}
                    {t.kind === 'working' && <span class="wt__rays" set:html={rays()} />}
                    {t.kind === 'done' && <Fragment set:html={ic.check} />}
                    {t.state}
                  </span>
                </div>
                <div class="wt__sub">{t.sub}</div>
                <div class="wt__body">
                  {t.steps && (
                    <ol class="trail">
                      {t.steps.map(([verb, target, end]: string[]) => (
                        <li data-on={verb === 'Running' ? '' : undefined}><span class="trail__dot" /><b>{verb}</b><code>{target}</code><span class="trail__end">{end}</span></li>
                      ))}
                    </ol>
                  )}
                  {t.ask && (
                    <div class="wt__card">
                      <span class="wt__lead"><Fragment set:html={ic.hand} />{t.ask.lead}</span>
                      <code class="wt__cmd">{t.ask.cmd}</code>
                      <span class="wt__acts"><span class="ui-btn ui-btn--quiet">Not this</span><span class="ui-btn ui-btn--act">Run it</span></span>
                    </div>
                  )}
                  {t.lead && (
                    <div class="wt__brief">
                      <p class="wt__leadline">{t.lead}</p>
                      <ul class="wt__points">{t.points.map((x: string) => <li>{x}</li>)}</ul>
                      <ul class="wt__files">
                        {t.files.map(([name, dir, add, del]: string[]) => (
                          <li><Fragment set:html={ic.file} /><span class="wt__fname">{name}</span><span class="wt__fdir">{dir}</span><span class="lines"><span class="ui-add">{add}</span>{del && <span class="ui-del">{del}</span>}</span></li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
                <div class="wt__foot">
                  {t.kind === 'needs' && <span class="wt__field"><span>{t.field}</span><span class="wt__send" set:html={ic.send} /></span>}
                  {t.kind === 'working' && <span>{t.foot}</span>}
                  {t.kind === 'done' && (
                    <>
                      <span class="lines"><span class="ui-add">{t.foot[0]}</span><span class="ui-del">{t.foot[1]}</span></span>
                      <span>{t.foot[2]}</span>
                      <span class="wt__vf"><Fragment set:html={ic.verified} />Verified</span>
                      <span class="wt__grow" />
                      <span class="ui-btn ui-btn--quiet wt__settle"><Fragment set:html={ic.settle} />Settle</span>
                    </>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>

    <article class="card card--turn" data-reveal="up">
      <h3 class="card__title">One turn, from ask to diff</h3>
      <p class="card__text">Ask in plain words. It asks before it guesses, plans, builds, and hands you a diff to keep or undo.</p>
      <div class="card__show peek peek--right">
        <img src="/media/mac-diff-1100.webp" srcset="/media/mac-diff-1100.webp 1100w, /media/mac-diff.webp 1800w" sizes="(max-width: 1023px) 190vw, 66vw" alt="The tide fix in Liner Code: the Demo's plan, its edit and test, and the Diff panel beside it with src/tides.js, Undo turn 1 and Commit 1 file." width="1800" height="1160" loading="lazy" decoding="async" />
      </div>
    </article>

    <article class="card card--surfaces" id="surfaces" data-reveal="up" data-delay="0.06">
      <h3 class="card__title">Surfaces beside the session</h3>
      <p class="card__text">The Browser, Design, Terminal, Files and the rest open next to the conversation, each one key away, and a live page in the Browser costs about what it costs on its own.</p>
      <div class="card__show peek peek--right">
        <img src="/media/mac-surfaces-1100.webp" srcset="/media/mac-surfaces-1100.webp 1100w, /media/mac-surfaces.webp 1800w" sizes="(max-width: 1023px) 190vw, 66vw"
          alt="The tide fix session with its panel open on the New tab guide: Session, Side chat, Browser, Design, Terminal, Files, Changes, Pull request and the rest, each with its key, and Changes, Files and Browser as tabs above."
          width="1800" height="1160" loading="lazy" decoding="async" />
      </div>
    </article>

    <article class="card card--span card--crew" id="agents" data-reveal="up">
      <div class="crew__text">
        <p class="card__new">{news.since}</p>
        <h3 class="card__title">{c.title}</h3>
        <p class="card__text">{c.text}</p>
        <dl class="crew__tools">
          {c.tools.map((t) => <div><dt>{t.name}</dt><dd>{t.note}</dd></div>)}
        </dl>
      </div>
      <div class="card__show card__frag crew__show">
        <div class="frag crew" data-ui role="img" aria-label={c.alt}>
          <div class="crew__top" aria-hidden="true">
            <span class="crew__session">{c.session}</span>
            <span class="crew__chip">
              <span class="faces"><span data-lead set:html={rays(10)} /><span set:html={ic.explore} /><span set:html={ic.sub} /></span>
              {c.lead}<span class="crew__quiet"> + 3 agents</span>
              <Fragment set:html={ic.chevD} />
            </span>
          </div>
          <div class="crew__thread" aria-hidden="true">
            <p class="crew__ask">{c.ask}</p>
            <p class="crew__who"><span class="crew__rays" set:html={rays()} /><b>{c.lead}</b><span>working · 0:12</span></p>
            <div class="fan">
              <p class="fan__h"><Fragment set:html={ic.fanout} />Started 3 agents<span class="crew__quiet"> · 1 done, 2 working</span></p>
              <div class="fan__kids">
                {c.agents.map((a: any) => (
                  <div class="fan__kid" data-on={a.done ? undefined : ''}>
                    <span class="fan__1">
                      <span class="fan__mark" data-state={a.done ? 'done' : 'running'}>{a.done ? <Fragment set:html={ic.check} /> : <i />}</span>
                      <span class="fan__kind" set:html={ic[a.kind as 'explore' | 'test' | 'sub']} />
                      <b>{a.name}</b>
                      <span class="fan__task">{a.done ?? a.task}</span>
                      <span class="fan__m">{a.model ?? a.time}</span>
                    </span>
                    {!a.done && <span class="fan__2"><span class="fan__now">{a.now}</span><span class="fan__m">{a.stats}</span></span>}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="crew__foot" aria-hidden="true">
            <div class="crs">
              <span class="faces"><span set:html={ic.explore} /><span set:html={ic.sub} /></span>
              <span class="crs__t">{c.strip.waiting}<span class="crew__quiet"> · {c.strip.doing}</span></span>
              <span class="crs__i" set:html={ic.info} />
              <span class="crs__stop">Stop agents</span>
            </div>
            <div class="crew__box"><span>Steer it, or ask something</span><span class="crew__stop" set:html={stop(11)} /></div>
          </div>
        </div>
      </div>
    </article>

    <article class="card card--servers" id="servers" data-reveal="up">
      <p class="card__new">{news.since}</p>
      <h3 class="card__title">{sv.title}</h3>
      <p class="card__text">{coded(sv.text).map((x, i) => (i % 2 ? <code>{x}</code> : x))}</p>
      <div class="card__show card__frag">
        <div class="frag launch" data-ui role="img" aria-label={sv.alt}>
          <p class="launch__step" aria-hidden="true"><span class="trail__dot" /><b>{sv.step[0]}</b><code>{sv.step[1]}</code><span class="trail__end">{sv.step[2]}</span></p>
          <div class="launch__br" aria-hidden="true">
            <p class="launch__tab"><Fragment set:html={ic.globe} />Browser</p>
            <ul class="launch__rows">
              {sv.rows.map((r: any) => (
                <li data-on={r.on ? '' : undefined}>
                  <span class="launch__main">
                    <Fragment set:html={ic.server} />
                    <span class="launch__text"><span class="launch__name">{r.name}</span>{r.note && <span class="launch__note">{r.note}</span>}</span>
                    <code class="launch__port">:{r.port}</code>
                  </span>
                  {r.on && <span class="launch__go" set:html={ic.refresh} />}
                  {r.on ? <span class="launch__go launch__stop" set:html={stop(10)} /> : <span class="launch__go" set:html={ic.play} />}
                </li>
              ))}
            </ul>
            <p class="launch__foot">{sv.foot}</p>
          </div>
        </div>
      </div>
    </article>

    <article class="card card--plugins" id="plugins" data-reveal="up" data-delay="0.06">
      <p class="card__new">{news.since}</p>
      <h3 class="card__title">{pl.title}</h3>
      <p class="card__text">{pl.text}</p>
      <div class="card__show card__frag">
        <div class="frag dsh" data-ui role="img" aria-label={pl.alt}>
          <p class="ui-note" aria-hidden="true">{pl.from}</p>
          <p class="dsh__title" aria-hidden="true">{pl.name}</p>
          <p class="dsh__ask" aria-hidden="true"><span class="dsh__icon" set:html={ic.chip} />{pl.ask}</p>
          <dl class="dsh__fields" aria-hidden="true">
            {pl.fields.map(([k, v]) => <div><dt>{k}</dt><dd>{k === 'Plugin' ? <code>{v}</code> : v}</dd></div>)}
          </dl>
          <div class="dsh__foot" aria-hidden="true"><span class="ui-btn ui-btn--quiet">Not this</span><span class="ui-btn ui-btn--act">Hold to allow</span></div>
        </div>
      </div>
    </article>

    {shots.map((c, i) => (
      <article class:list={['card', 'card--shot', `card--${c.id}`]} data-reveal="up" data-delay={String((i % 2) * 0.06)}>
        <h3 class="card__title">{c.title}</h3>
        <p class="card__text">{c.text}{c.link && <> <a class="card__link" href={c.link.href}>{c.link.label}</a></>}</p>
        <div class:list={['card__show', 'peek', `peek--${c.pos}`]}>
          <img src={c.src.replace(".webp", "-1100.webp")} srcset={`${c.src.replace(".webp", "-1100.webp")} 1100w, ${c.src} 1800w`} sizes="(max-width: 1023px) 190vw, 66vw" alt={c.alt} width="1800" height="1160" loading="lazy" decoding="async" />
        </div>
      </article>
    ))}

    <article class="card card--pair" id="pair" data-reveal="up" data-delay="0.06">
      <h3 class="card__title">{pr.title}</h3>
      <p class="card__text">{pr.text}</p>
      <div class="card__show">
        <dl class="crew__tools">
          {pr.roles.map((r) => <div><dt>{r.name}</dt><dd>{r.note}</dd></div>)}
        </dl>
      </div>
    </article>

    <article class="card card--wide" id="data" data-reveal="up">
      <div class="card__body">
        <h3 class="card__title">Nothing in between</h3>
        <p class="card__text">No server, no telemetry. Sign-ins stay with each tool, keys stay in your Mac's keychain, and model traffic goes straight to each provider.</p>
      </div>
      <figure class="card__show card__code mini">
        <pre><code><span class="c-com"># All it asks each tool</span>
{data.commands.map((c) => <span><span class="c-prompt">$</span> {c}{'\n'}</span>)}</code></pre>
      </figure>
    </article>

  </div>
  <p class="bento__note">Pictures: the Liner Code app on macOS, in dark mode, with the Demo agent on its sample project. What's new in 0.2.4 is drawn from the app's own parts, in its words.</p>
</section>
