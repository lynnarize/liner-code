---
import Head from './Head.astro';
import Rule from './Rule.astro';
import Shot from './Shot.astro';
import Frag from './Frag.astro';
import { code } from '../data/site';
const { fusion, wall } = code;
---
<section id="code">
  <div class="wrap">
    <Head tag={code.tag} dim={code.dim} head={code.head} sub={code.sub} more={code.more} />
  </div>
  <Rule />
  <div class="wrap">
    <div class="grid row">
      <div class="say settle">
        <h3><span class="dim">{fusion.dim}</span>{fusion.title}</h3>
        <p>{fusion.text}</p>
      </div>
      <div class="stage sand narrow settle d1"><div class="shot foot" data-ui><Shot name={fusion.name} alt={fusion.alt} /></div></div>
    </div>
  </div>
  <Rule />
  <div class="wrap">
    <div class="grid row flip">
      <div class="stage sky settle"><div class="shot foot" data-ui><Shot name={wall.name} alt={wall.alt} /></div></div>
      <div class="say settle d1">
        <h3><span class="dim">{wall.dim}</span>{wall.title}</h3>
        <p>{wall.text}</p>
      </div>
    </div>
  </div>
  <Rule />
  <div class="wrap">
    <div class="cells wide-narrow">
      {code.cells.map((f, i) => <Frag f={f} class={i ? 'd1' : undefined} />)}
    </div>
  </div>
  <Rule />
  <div class="wrap">
    <p class="tag" style="padding-block: 30px 22px"><i></i>{code.also.tag}</p>
    <ul class="table">
      {code.also.rows.map((r) => <li class="settle"><b>{'href' in r && r.href ? <a href={r.href}>{r.b}</a> : r.b}</b><span>{r.span}</span><code>{r.code}</code></li>)}
    </ul>
  </div>
</section>
