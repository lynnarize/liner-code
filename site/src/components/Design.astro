---
import Head from './Head.astro';
import Rule from './Rule.astro';
import Shot from './Shot.astro';
import Frag from './Frag.astro';
import shots from '../data/shots.json';
import { design } from '../data/site';
const first = (shots as Record<string, { w: number; h: number }>)[design.steps[0].name];
---
<section id="design">
  <div class="wrap">
    <Head tag={design.tag} dim={design.dim} head={design.head} sub={design.sub} />
    <div class="grid pin">
      <div class="pin-copy">
        {design.steps.map((s, i) => (
          <div class:list={['step', { on: i === 0 }]} data-step={i}>
            <div class="stage chart"><div class="shot foot" data-ui><Shot name={s.name} alt={s.alt} /></div></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <div class="pin-stage" aria-hidden="true">
        <div class="stage chart">
          <div class="shot" data-ui id="pin" style={`aspect-ratio: ${first.w} / ${first.h}`}>
            {design.steps.map((s, i) => <Shot name={s.name} alt="" class={i === 0 ? 'on' : undefined} />)}
          </div>
        </div>
        <div class="pin-count" id="pin-count">{design.steps.map((_, i) => <i class={i === 0 ? 'on' : undefined}></i>)}</div>
      </div>
    </div>
  </div>
  <Rule />
  <div class="wrap">
    <div class="cells c4">
      {design.cells.map((f, i) => <Frag f={f} class={i ? `d${i}` : undefined} />)}
    </div>
  </div>
</section>
