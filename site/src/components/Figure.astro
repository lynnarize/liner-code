---
// You, standing in the middle of the sea. Two views: from the side, and from above once the
// camera has tipped over the pole.
---
<div class="figure" data-figure aria-hidden="true">
  <svg class="figure__side" viewBox="0 0 20 56" fill="currentColor">
    <ellipse cx="10" cy="5.3" rx="3.5" ry="4.2" />
    <path d="M5.3 11.6c1.4-1.4 8-1.4 9.4 0l1.3 15.6c.1 1.2-.8 1.6-1.4.8l-.6-5.6-.4 8.8-.2 22.4c0 1.5-2.5 1.5-2.6 0L10.2 34h-.4l-.6 19.6c-.1 1.5-2.6 1.5-2.6 0L6.4 31.2 6 22.4l-.6 5.6c-.6.8-1.5.4-1.4-.8z" />
  </svg>
  <svg class="figure__top" viewBox="0 0 40 40" fill="currentColor">
    <ellipse cx="20" cy="21" rx="11" ry="5.6" />
    <circle cx="20" cy="20.4" r="4.6" fill="#1b2140" />
  </svg>
</div>
