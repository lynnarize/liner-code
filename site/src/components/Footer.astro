---
import Mark from './Mark.astro';
import { footer, site } from '../data/site';
---
<footer class="foot">
  <div class="tiles">
    <div class="tile say">
      <p>{footer.say}</p>
      <p class="small">{footer.copy}</p>
    </div>
    <nav class="tile navt" aria-label="Footer">
      {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="tile ver">
      <b>{site.label}</b>
      <p class="small">{footer.platforms}</p>
    </div>
    <div class="tile word" aria-hidden="true">
      <div class="big"><Mark /><span>Liner</span></div>
    </div>
    <a class="tile get" href={site.latest}>
      <span>{footer.get}</span>
      <svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 42 42 14M20 14h22v22"/></svg>
    </a>
  </div>
</footer>
