---
// A section's head: its tag, a one-line heading and at most a line beside it.
interface Props { tag: string; head: string; sub?: string; isNew?: boolean; more?: { href: string; label: string }; id?: string }
const { tag, head, sub, isNew = false, more, id } = Astro.props;
---
<div class="head">
  <p class="tag settle"><i></i>{tag}{isNew && <> <b>New</b></>}</p>
  <h2 class="h2 settle" id={id}>{head}</h2>
  {sub && <p class="sub settle d1">{sub}{more && <a class="link more" href={more.href}>{more.label}</a>}</p>}
  <slot />
</div>
