---
import Shot from './Shot.astro';
import { hero, site } from '../data/site';
import { APPLE } from '../data/icons';
---
<section class="hero" id="top">
  <div class="wrap">
    <a class="callout" href={hero.callout.href}>
      <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
      <span>{hero.callout.tag}</span><em>{hero.callout.text}</em>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4"/></svg>
    </a>
    <h1 class="faces">
      {hero.faces.map((f, i) => <button type="button" class="face" data-face={i} aria-pressed={String(i === 0)}><span>{f}</span></button>)}
    </h1>
    <div class="hero-sub">
      <p class="lead">{hero.lead}</p>
      <div class="hero-act">
        <a class="btn" href="#download"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={APPLE}/></svg>Download for macOS</a>
        <a class="btn quiet" href="#download">Windows</a>
        <p class="small">{hero.small}</p>
      </div>
    </div>
    <div class="stagehead">
      <p class="cap" id="cap" aria-live="polite" data-caps={JSON.stringify(hero.caps)}><b>{hero.caps[0][0]}</b><span>{hero.caps[0][1]}</span></p>
      <div class="keys" aria-hidden="true">
        {hero.faces.map((_, i) => <button type="button" tabindex="-1" data-face={i} aria-pressed={String(i === 0)}>{i + 1}</button>)}
      </div>
    </div>
    <div class="stage hero-stage" id="stage">
      {hero.shots.map((s, i) => <div class:list={['bd', s.stage, { on: i === 0 }]}></div>)}
      <div class="window" data-ui id="window">
        {hero.shots.map((s, i) => <Shot name={s.name} alt={s.alt} class={i === 0 ? 'on' : undefined} priority={i === 0} />)}
      </div>
    </div>
  </div>
</section>
