---
// The whole first screen is the sea of code at rest, almost the page's ground, and the pointer
// carries a lamp that brings the code up under it (after usemono.dev's torch). The promise sits in
// the middle with the sea calm under it, and the app's window rises from the foot of the screen,
// the sea parted round it. A click sends a ripple that lights the lines it crosses.
import SeaStage from './SeaStage.astro';
import Shot from './Shot.astro';
import { hero, home, site } from '../data/site';
const [noteA, noteB] = hero.note.split('{v}');
---
<section class="hero hero--torch" data-hero data-tone="paper" aria-labelledby="hero-title">
  <SeaStage kind="lay" class="stage--torch" torch label="A sea of code in rings, made of lines from Liner Code's own source, at rest. The pointer lights the code under it, and a click sends a ripple.">
    <div class="hero__top" data-words>
      <h1 id="hero-title" class="hero__title" data-split="words" data-intro data-delay="0.2">{hero.title}</h1>
      <p class="hero__lead" data-reveal="focus" data-intro data-delay="0.45">{hero.lead}</p>
      <div class="hero__act" data-reveal="focus" data-intro data-delay="0.6">
        <div class="hero__buttons">
          <a class="btn btn--ink" href={site.mac} data-rel="mac">Download for Mac</a>
          <a class="btn btn--soft" href={site.win} data-rel="win">{site.winLabel}</a>
        </div>
        <p class="hero__note">{noteA}<span data-rel="version">{site.version}</span>{noteB}</p>
      </div>
    </div>
    <div class="floor" data-floor data-reveal="up" data-intro data-delay="0.7">
      <Shot name="agents" alt={home.alt} w={2000} h={1250} eager wide sizes="(max-width: 767px) 205vw, min(74vw, 1104px)" />
    </div>
  </SeaStage>
</section>
