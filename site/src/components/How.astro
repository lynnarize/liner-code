---
// One turn in two steps, each a picture of the app with a line beside it: the plan it waits on,
// and the check another maker's model gives the change. The first is the Demo planning its tide
// fix; the second is Settings, where the check is set.
import Shot from './Shot.astro';
import { steps } from '../data/site';
const pics = [
  { name: 'plan', cls: 'win--fit', w: 1440, h: 1382, scene: '' },
  { name: 'check', cls: 'win--corner win--check', w: 1700, h: 1236, scene: 'scene--c' },
];
---
<section class="turn" id="how" data-tone="paper" aria-labelledby="how-title">
  <h2 class="sec-title" id="how-title" data-reveal="focus"><span class="dim">One turn,</span> checked before it's yours</h2>
  <ol class="steps">
    {steps.map((s, i) => (
      <li class:list={['step', i % 2 === 1 && 'step--flip']}>
        <div class:list={['scene', pics[i].scene]} data-reveal="up">
          <div data-ui class:list={['win', pics[i].cls]}><Shot name={pics[i].name} alt={s.alt} w={pics[i].w} h={pics[i].h} /></div>
        </div>
        <div class="step__text">
          <h3 class="step__title" data-reveal="focus">{s.title}</h3>
          <p class="step__d" data-reveal="focus" data-delay="0.08">{s.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
