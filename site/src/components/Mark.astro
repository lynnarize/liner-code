---
// The mark, in one place: the nav, the footer tile and (by hand, in public/favicon.svg and scripts/icons.cjs)
// the icons. Provisional: two slanted strokes, the second in the accent; the owner is choosing among options.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['mark', cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" aria-hidden="true"><path d="M5.2 19.6 10.6 4.4"/><path class="mark-accent" d="M13.4 19.6 18.8 4.4" stroke="#2a6fe8"/></svg>
