---
import Mark from './Mark.astro';
import { nav, site } from '../data/site';
interface Props { home?: boolean }
const { home = false } = Astro.props;
// On the home page its own sections are a jump away; elsewhere they lead back to it.
const href = (h: string) => (home && h.startsWith('/#') ? h.slice(1) : h);
---
<header class="nav" id="site-nav">
  <div class="wrap nav-in">
    <a class="brand" href={home ? '#top' : '/'} aria-label="Liner Code, home">
      <Mark />
      <span>Liner</span>
    </a>
    <nav class="nav-links" id="nav-menu" aria-label="Sections">
      {nav.map((l) => <a href={href(l.href)} aria-current={!home && Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav-end">
      <button class="look" type="button" id="look" aria-label="Dark look" aria-pressed="false" title="Switch to the dark look">
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.2A8 8 0 1 1 9.8 4a6.4 6.4 0 0 0 10.2 10.2Z"/></svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
      <a class="gh" href={site.repo} aria-label="Liner Code on GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.8.55A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <a class="btn small-btn" href={home ? '#download' : '/#download'}>Download</a>
      <button class="nav-toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
        <svg class="ico-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="ico-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
</header>
<script is:inline>
  // Under 960px the section links are hidden until this opens them. Escape, a link, or a click outside closes it.
  (function () {
    var header = document.getElementById('site-nav');
    var btn = document.getElementById('nav-toggle');
    var menu = document.getElementById('nav-menu');
    if (!header || !btn || !menu) return;
    var open = function () {
      btn.setAttribute('aria-expanded', 'true');
      header.classList.add('menu-open');
      var first = menu.querySelector('a');
      if (first) first.focus();
    };
    var close = function () {
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      btn.setAttribute('aria-expanded', 'false');
      header.classList.remove('menu-open');
    };
    btn.addEventListener('click', function () {
      if (btn.getAttribute('aria-expanded') === 'true') close();
      else open();
    });
    header.addEventListener('click', function (e) {
      var n = e.target && e.target.nodeType === 1 ? e.target : e.target && e.target.parentElement;
      if (n && n.closest && n.closest('a')) close();
    });
    menu.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'Home' && e.key !== 'End') return;
      var links = [].slice.call(menu.querySelectorAll('a'));
      var i = links.indexOf(document.activeElement);
      if (!links.length) return;
      e.preventDefault();
      var n = e.key === 'ArrowDown' ? (i + 1) % links.length : e.key === 'ArrowUp' ? (i - 1 + links.length) % links.length : e.key === 'Home' ? 0 : links.length - 1;
      links[n].focus();
    });
    document.addEventListener('click', function (e) {
      if (!header.classList.contains('menu-open') || header.contains(e.target)) return;
      close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || btn.getAttribute('aria-expanded') !== 'true') return;
      close();
      btn.focus();
    });
    var narrow = matchMedia('(max-width: 960px)');
    if (narrow.addEventListener) narrow.addEventListener('change', function (e) { if (!e.matches) close(); });
  })();
</script>
