---
import Mark from './Mark.astro';
import { download, nav, site } from '../data/site';
const path = Astro.url.pathname;
const arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>';
---
<header class="nav" data-nav>
  <a class="nav__brand" href="/" aria-label="Liner Code, home">
    <Mark class="nav__mark" />
    <span>Liner Code</span>
  </a>
  <nav class="nav__links" aria-label="Main">
    <ul>
      {nav.map((l) => (
        <li><a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="nav__end">
  <!-- The sea at night (the default) or blue; kept for this visitor. -->
  <div class="seas" role="group" aria-label="Sea" data-seas>
    <button type="button" data-pick="dark" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>Night</button>
    <button type="button" data-pick="blue" aria-pressed="false"><span class="seas__dot" aria-hidden="true"></span>Blue</button>
  </div>
  <!-- The repository, with its stars (read at build time, kept fresh by motion/release.ts). -->
  <a class="stars" href={site.repo} rel="noopener" data-stars-link
    aria-label={site.starsExact === null ? 'Liner Code on GitHub' : `Star Liner Code on GitHub, ${site.starsExact} ${site.starsExact === 1 ? 'star' : 'stars'} so far`}>
    <svg class="stars__gh" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span class="stars__label">Star</span>{site.stars !== null && <span class="stars__n"><svg class="stars__star" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .8l2.2 4.6 5 .7-3.6 3.5.9 5L8 12.2l-4.5 2.4.9-5L.8 6.1l5-.7L8 .8Z"/></svg><span data-rel="stars-n">{site.stars}</span></span>}
  </a>
  <!-- Download opens a short menu: the Mac and Windows files, straight from the latest release.
       Without script it is a link to the download section. -->
  <div class="get" data-get>
    <a class="btn btn--nav" href="/#download" data-get-btn>Download<svg class="get__chev" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    <div class="get__menu" id="get-menu" hidden data-get-menu>
      <p class="get__title">Liner Code <span data-rel="version">{site.version}</span>, an alpha</p>
      <div class="get__list">
        {(['mac', 'win'] as const).map((os) => (
          <a class="get__os" href={site[os]} data-rel={os} data-get-os={os}>
            <span class="get__name">{download[os].label}</span>
            <span class="get__sub">{download[os].short}</span>
            <span class="get__arrow" set:html={arrow} />
          </a>
        ))}
      </div>
      <p class="get__foot"><a href="/#download">How to install</a><a href={site.releases} rel="noopener">All releases</a></p>
    </div>
  </div>
  <button class="nav__menu" type="button" aria-expanded="false" aria-controls="sheet" data-menu>Menu</button>
  </div>
  <div class="sheet" id="sheet" hidden data-sheet>
    <ul>
      {nav.map((l) => <li><a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a></li>)}
      <li><a href={site.repo} rel="noopener">GitHub{site.stars !== null && <span class="sheet__stars"> · <span data-rel="stars-n">{site.stars}</span> {site.starsExact === 1 ? 'star' : 'stars'}</span>}</a></li>
      <li><a href="/#download">Download</a></li>
    </ul>
    <div class="seas seas--sheet" role="group" aria-label="Sea" data-seas>
      <button type="button" data-pick="dark" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>Night</button>
      <button type="button" data-pick="blue" aria-pressed="false"><span class="seas__dot" aria-hidden="true"></span>Blue</button>
    </div>
  </div>
</header>
