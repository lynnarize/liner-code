---
import { faq } from '../data/site';
---
<section id="questions">
  <div class="wrap">
    <div class="head">
      <p class="tag settle"><i></i>{faq.tag}</p>
      <h2 class="h2 settle"><span class="dim">{faq.dim}</span>{faq.head}</h2>
    </div>
    <div class="faq">
      {faq.items.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </div>
</section>
