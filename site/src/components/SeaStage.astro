---
// A stage for the sea of code: the sky, a word that sits on the horizon, the ground and you.
// The one canvas moves into whichever stage is on screen. Without WebGL the ground is a picture.
// "lay" is the sea from overhead with the app lying on it (the home page's hero): no word, no figure.
import Figure from './Figure.astro';
interface Props {
  kind: 'hero' | 'lay' | 'page' | 'tile';
  class?: string;
  label?: string;
  torch?: boolean; // the sea at rest, lit by a lamp the pointer carries
}
const { kind, class: cls, label, torch = false } = Astro.props;
---
<div class:list={['stage', `stage--${kind}`, cls]} data-sea-stage={kind} data-torch={torch ? '' : undefined} data-tone="sky">
  <div class="stage__word" data-stage-word>
    <slot name="word" />
  </div>
  <picture class="stage__ground" aria-hidden="true">
    {kind === 'lay'
      ? <img src="/media/sea-above.jpg" alt="" width="1280" height="800" decoding="async" />
      : <>
          <source media="(max-width: 767px)" srcset="/media/ground-phone.webp" />
          <img src="/media/ground.webp" alt="" width="2400" height="843" decoding="async" fetchpriority={kind === 'hero' ? 'high' : 'auto'} />
        </>}
  </picture>
  <div class="sea-slot" data-sea-slot role={label ? 'img' : undefined} aria-label={label}></div>
  <Figure />
  <slot />
</div>
