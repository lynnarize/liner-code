---
import Head from './Head.astro';
import Shot from './Shot.astro';
import Frag from './Frag.astro';
import { security } from '../data/site';
---
<section id="security">
  <div class="wrap">
    <Head tag={security.tag} dim={security.dim} head={security.head} sub={security.sub} isNew />
    <div class="stage steel settle" style="padding: clamp(20px, 4vw, 56px) 5% 0">
      <div class="shot foot" data-ui><Shot name={security.shot.name} phone={security.shot.phone} alt={security.shot.alt} /></div>
    </div>
    <div class="cells wide-narrow">
      {security.first.map((f, i) => <Frag f={f} class={i ? 'd1' : undefined} />)}
    </div>
    <div class="rule" style="margin-inline: calc(-1 * var(--bleed))" aria-hidden="true"></div>
    <div class="cells narrow-wide">
      {security.second.map((f, i) => <Frag f={f} class={i ? 'd1' : undefined} />)}
    </div>
  </div>
</section>
