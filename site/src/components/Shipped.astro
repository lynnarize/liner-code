---
import { shipped } from '../data/site';
---
<section id="shipped">
  <div class="wrap">
    <div class="head">
      <p class="tag settle"><i></i>{shipped.tag}</p>
      <h2 class="h2 settle"><span class="dim">{shipped.dim}</span>{shipped.head}</h2>
      <p class="sub settle d1"><a class="link" href="/changelog/">{shipped.link}</a></p>
    </div>
    <ul class="table log">
      {shipped.rows.map((r, i) => <li class:list={['settle', { new: i === 0 }]}><code>{r.date}</code><b><a href={`/changelog/#v${r.v}`}>{r.v}</a></b><span>{r.span}</span></li>)}
    </ul>
  </div>
</section>
