---
// A picture of the app in both looks, one shown by the theme. It is a <picture>: the dark file is a
// <source> for the dark look and the light file the <img>, so only the shown one is fetched. The page
// script (Base.astro) rewrites the dark sources' media when the visitor picks a look by hand. Sizes come
// from shots.json, never from here. `phone` is another picture for screens up to 640px wide.
import shots from '../data/shots.json';

interface Props { name: string; alt: string; phone?: string; class?: string; style?: string; loading?: 'lazy' | 'eager'; priority?: boolean }
const { name, alt, phone, class: cls, style, loading = 'lazy', priority = false } = Astro.props;
const size = (n: string) => {
  const s = (shots as Record<string, { w: number; h: number; scale: number }>)[n];
  if (!s) throw new Error(`shots.json has no "${n}"`);
  return s;
};
const main = size(name);
const ph = phone ? size(phone) : null;
const src = (n: string, look: string) => `/shots/${n}-${look}.webp`;
const PHONE = '(max-width: 640px)';
const DARK = '(prefers-color-scheme: dark)';
---
<picture>
  {ph && <source media={`${PHONE} and ${DARK}`} data-m={PHONE} data-look="dark" srcset={src(phone!, 'dark')} width={ph.w} height={ph.h} />}
  {ph && <source media={PHONE} srcset={src(phone!, 'light')} width={ph.w} height={ph.h} />}
  <source media={DARK} data-m="" data-look="dark" srcset={src(name, 'dark')} width={main.w} height={main.h} />
  <img class={cls} style={style} src={src(name, 'light')} width={main.w} height={main.h} alt={alt} loading={priority ? 'eager' : loading} decoding="async" fetchpriority={priority ? 'high' : undefined} />
</picture>
