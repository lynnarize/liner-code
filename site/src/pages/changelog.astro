---
import Base from '../layouts/Base.astro';
import { releases, longDate, isoDate } from '../lib/changelog';
const all = releases();
const first = all.at(-1)!, last = all[0]!;
const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : s);
---
<Base title="Changelog" description={`Every Liner Code release, from ${first.version} to ${last.version}: what's new, what changed and what was fixed.`}>
  <section class="page-head" aria-labelledby="cl-title">
    <div class="wrap">
      <p class="tag"><i></i>Changelog</p>
      <h1 class="h2" id="cl-title"><span class="dim">Every release.</span>Newest first.</h1>
      <p class="sub">{all.length} releases, from {first.version} on {longDate(first.date)} to {last.version} on {longDate(last.date)}, as the repository's CHANGELOG.md has them.</p>
      <nav class="index" aria-label="Releases">{all.map((r) => <a href={`#v${r.version}`}>{r.version}</a>)}</nav>
    </div>
  </section>
  <div class="wrap">
    <div class="releases">
      {all.map((r, i) => (
        <article class="release" id={`v${r.version}`} aria-labelledby={`h-${r.version}`}>
          <header class="release-head">
            <h2 id={`h-${r.version}`}>{r.version}</h2>
            <p>{i === 0 && <><b>Newest</b> · </>}{cap(r.title)}{r.title && ', '}<time datetime={isoDate(r.date)}>{longDate(r.date)}</time></p>
          </header>
          <div class="release-body" set:html={r.html} />
        </article>
      ))}
    </div>
  </div>
</Base>
