---
// Workshop, one thing: ask for what Liner Code doesn't have, and an agent builds it as an add-on.
// The Demo agent can't play a Workshop turn, so the turn is told in words; the pictures are the
// Add-ons page and Home in Workshop, from the 0.3.2 app with the Demo.
import Base from '../layouts/Base.astro';
import Head from '../components/Head.astro';
import Rule from '../components/Rule.astro';
import Shot from '../components/Shot.astro';
import Rows from '../components/Rows.astro';
import Close from '../components/Close.astro';
import { workshop as w } from '../data/pages';
const { kinds, ways, gate, turn, keep } = w;
---
<Base title={w.title} description={w.description}>
  <section class="page-head" aria-labelledby="ws-title">
    <div class="wrap">
      <p class="tag"><i></i>{w.tag}</p>
      <h1 class="h2 long" id="ws-title"><span class="dim">{w.dim}</span>{w.head}</h1>
      <p class="sub lead-sub">{w.lead}</p>
    </div>
  </section>
  <Rule />

  <section aria-labelledby="ws-kinds">
    <div class="wrap">
      <div class="head">
        <p class="tag settle"><i></i>{kinds.tag}</p>
        <h2 class="h2 settle" id="ws-kinds">{kinds.head}</h2>
      </div>
    </div>
    <Rule />
    <div class="wrap">
      <div class="cells c4 kinds">
        {kinds.items.map((k, i) => <article class:list={['cell settle', i ? `d${i}` : '']}><p class="kind">{k.kind}</p><h3>{k.title}</h3><p>{k.text}</p></article>)}
      </div>
    </div>
  </section>
  <Rule />

  <section aria-labelledby="ws-ways">
    <div class="wrap">
      <Head tag={ways.tag} head={ways.head} sub={ways.sub} />
    </div>
    <Rule />
    <div class="wrap">
      <div class="grid row">
        <div class="say settle">
          <h3>{ways.page.title}</h3>
          <p>{ways.page.text}</p>
        </div>
        <div class="stage sky settle d1"><div class="shot foot" data-ui><Shot name={ways.page.name} alt={ways.page.alt} /></div></div>
      </div>
    </div>
    <Rule />
    <div class="wrap">
      <div class="grid row flip">
        <div class="stage mist pad settle"><div class="shot" data-ui><Shot name={ways.home.name} alt={ways.home.alt} /></div></div>
        <div class="say settle d1">
          <h3>{ways.home.title}</h3>
          <p>{ways.home.text}</p>
        </div>
      </div>
      <Rows rows={ways.rows} />
    </div>
  </section>
  <Rule />

  <section aria-labelledby="ws-gate">
    <div class="wrap">
      <div class="head">
        <p class="tag settle"><i></i>{gate.tag}</p>
        <h2 class="h2 settle" id="ws-gate">{gate.head}</h2>
      </div>
      <div class="trust">
        <div class="trust-say settle">
          <p class="lead">{gate.lead}</p>
        </div>
        <dl>
          {gate.items.map((t, i) => <div class:list={['settle', { d1: i % 2 === 1 }]}><dt>{t.dt}</dt><dd>{t.dd}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>
  <Rule />

  <section aria-labelledby="ws-turn">
    <div class="wrap">
      <div class="head">
        <p class="tag settle"><i></i>{turn.tag}</p>
        <h2 class="h2 settle" id="ws-turn">{turn.head}</h2>
      </div>
      <Rows rows={turn.rows} steps />
    </div>
  </section>
  <Rule />

  <section aria-labelledby="ws-keep">
    <div class="wrap">
      <div class="head">
        <p class="tag settle"><i></i>{keep.tag}</p>
        <h2 class="h2 settle" id="ws-keep">{keep.head}</h2>
      </div>
      <Rows rows={keep.rows} />
    </div>
  </section>
  <Rule />

  <section aria-labelledby="ws-try">
    <div class="wrap">
      <Head tag={w.try.tag} head={w.try.head} sub={w.try.sub} />
    </div>
    <Rule />
    <div class="wrap">
      <div class="cells c3 asks">
        {w.try.items.map((e, i) => (
          <article class:list={['cell settle', i ? `d${i}` : '']}>
            <h3>{e.h}</h3>
            <blockquote><p>{e.ask}</p></blockquote>
            <p><b>What you get.</b> {e.expect}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Rule />
  <Close />
</Base>
